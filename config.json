{
  "app_name": "HP Assistant",
  "version": "2.2.0",
  "hotkey_enabled": false,
  "hotkey": "ctrl+alt+h",
  "beep_on_toggle": true,
  "toast_on_toggle": true,
  "log_file": "logs/assistant.log",
  "log_level": "INFO",
  "voice": {
    "wake_word": "wake up HP",
    "vosk_model_name": "vosk-model-small-en-in-0.4",
    "vosk_model_url": "https://alphacephei.com/vosk/models/vosk-model-small-en-in-0.4.zip",
    "stt_language": "en-IN",
    "stt_timeout_seconds": 6,
    "tts_voice": "en-IN-NeerjaNeural",
    "sample_rate": 16000,
    "session_timeout_seconds": 60,
    "pause_timeout_minutes": 10,
    "pause_phrases": [
      "pause"
    ],
    "resume_phrases": [
      "h p resume",
      "hp resume"
    ],
    "paused_sleep_phrases": [
      "h p sleep",
      "hp sleep"
    ],
    "sleep_phrases": [
      "go to sleep",
      "sleep",
      "stop listening"
    ]
  },
  "permissions": {
    "confirmation_timeout_seconds": 10,
    "audit_log_file": "logs/audit.log",
    "safe": [
      "volume",
      "scroll",
      "screenshot",
      "open_app",
      "media_play_pause",
      "window_switch",
      "cursor_move",
      "click"
    ],
    "confirm": [
      "close_window",
      "shutdown",
      "restart",
      "delete_file",
      "type_text",
      "run_command",
      "send_message",
      "cut",
      "drag_drop"
    ],
    "blocked": [
      "format_drive",
      "registry_edit",
      "disable_security",
      "install_software"
    ]
  }
}
